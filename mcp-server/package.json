{
  "name": "relaypay-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "relaypay-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:stdio": "tsx --env-file-if-exists=../.env src/index.ts --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
