{
  "name": "relaypay-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "ingest-kb": "tsx --env-file=../.env scripts/ingest-kb.ts",
    "evals": "tsx --env-file=../.env scripts/run-evals.ts",
    "test": "vitest run",
    "evidence": "tsx --env-file=../.env scripts/export-evidence.ts",
    "vapi:sync": "tsx --env-file=../.env scripts/vapi-sync.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@anthropic-ai/sdk": "^0.129.0",
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
