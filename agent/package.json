{
  "name": "relaypay-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=../.env scripts/seed.ts",
    "ingest-kb": "tsx --env-file=../.env scripts/ingest-kb.ts",
    "evals": "tsx --env-file=../.env scripts/run-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@supabase/supabase-js": "^2.117.2",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
