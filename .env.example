# Supabase (server-side only — never ship the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=

# Embeddings for KB retrieval
VOYAGE_API_KEY=

# Agent backend
PORT=8787
VAPI_SECRET=            # shared secret Vapi sends; checked on every request

# Frontend (Vite exposes VITE_* to the browser — public values only)
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
