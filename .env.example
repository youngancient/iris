# Supabase (server-side only — never ship the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=

# Embeddings for KB retrieval
VOYAGE_API_KEY=

# Agent backend
PORT=8787
VAPI_SECRET=            # shared secret Vapi sends; checked on every request

# MCP server (agent → MCP bearer token; generate with: openssl rand -hex 32)
MCP_TOKEN=
MCP_PORT=8788

# Frontend (Next.js exposes NEXT_PUBLIC_* to the browser — public values only)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
