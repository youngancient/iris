# Iris: environment for agent/ and mcp-server/ (both read this file).
# Copy to .env and fill in. The web app has its own file: web/.env.example.
#
# Required values have no defaults: a service refuses to start without them.
# Optional values are commented out, showing their default; uncomment to change.
# Keep comments on their own lines (a comment after a value can become part of it).
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Supabase (server-side only)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Secret / service_role key: full database access. Never put it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Claude (agent)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Live support model.
# AGENT_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# Knowledge-base search (agent)
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=
# Must support 512-dimension output. Changing it means re-running ingest-kb.
# VOYAGE_MODEL=voyage-4-lite
# Query embedding timeout before falling back to full-text search (100-10000).
# EMBED_TIMEOUT_MS=1000
# Minimum similarity for a knowledge-base match (0-1, calibrated for voyage-4-lite).
# RETRIEVAL_THRESHOLD=0.35

# ---------------------------------------------------------------------------
# Agent server
# ---------------------------------------------------------------------------
# Shared secret Vapi sends on every request (min 32 characters).
VAPI_SECRET=
# Where the agent reaches the MCP server (https outside localhost).
MCP_URL=http://localhost:8788/mcp
# PORT=8787

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
# Bearer token the agent sends to the MCP server (min 32 characters). Used by both.
MCP_TOKEN=
# Uses MCP_PORT, or 8788.
# MCP_PORT=8788

# ---------------------------------------------------------------------------
# Vapi assistant setup (only for: cd agent && npm run vapi:sync)
# ---------------------------------------------------------------------------
# Vapi dashboard -> API Keys -> private key (server-side only).
VAPI_PRIVATE_KEY=
# The agent's public https URL, e.g. https://iris-agent.up.railway.app
AGENT_URL=
# Printed by the first vapi:sync. Set it so later syncs update the assistant instead of creating a new one.
VAPI_ASSISTANT_ID=
