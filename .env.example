# Required values have no defaults: services refuse to start without them.
# Values marked optional have safe defaults and are range-checked.

# Supabase (server-side only — never ship the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5   # optional; live support model

# Embeddings for KB retrieval
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite     # must support 512-dimension output; changing it means re-ingesting
EMBED_TIMEOUT_MS=1000          # query embedding timeout before falling back to full-text search
RETRIEVAL_THRESHOLD=0.35       # min similarity for a knowledge-base match (calibrated for voyage-4-lite)

# Agent backend
PORT=8787
VAPI_SECRET=            # shared secret Vapi sends; min 32 chars (openssl rand -hex 32)
MCP_URL=http://localhost:8788/mcp   # where the agent reaches the MCP server (https outside localhost)

# MCP server (agent → MCP bearer token, min 32 chars; generate with: openssl rand -hex 32)
MCP_TOKEN=
MCP_PORT=8788

# Frontend (Next.js exposes NEXT_PUBLIC_* to the browser — public values only)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
