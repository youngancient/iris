# Iris web app (call page + admin dashboard). Copy to web/.env.local and fill in.
# Next.js reads env files from this folder, not the repo root.
# Keep comments on their own lines.

# ---------------------------------------------------------------------------
# Call page (browser). NEXT_PUBLIC_ values are built into the page: public values only.
# ---------------------------------------------------------------------------
# Vapi dashboard -> API Keys -> public key.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# The Iris assistant's ID (printed by: cd agent && npm run vapi:sync).
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ---------------------------------------------------------------------------
# Admin dashboard (server only). Never add a NEXT_PUBLIC_ prefix to these.
# ---------------------------------------------------------------------------
# Same values as the root .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Project Settings -> API keys -> publishable / anon key. Used only for staff sign-in.
SUPABASE_ANON_KEY=
# Comma-separated staff emails allowed into /admin.
ADMIN_EMAILS=
